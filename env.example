# EaveLuxOS container settings (copy to .env). Everything else is set in the app.

# Which address on the server the app listens on. 127.0.0.1 = this server only.
# To use it from phones on your home network, set the server's LAN address.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8787

# Host names (besides IP addresses and localhost) the app answers to,
# comma-separated, e.g. your server's .local name or your VPN name.
EAVELUXOS_ALLOWED_HOSTS=

# Optional: keep the secrets encryption key here instead of in the data volume
# (64 hex characters; generate with: python3 -c "import os;print(os.urandom(32).hex())").
# EAVELUXOS_SECRET_KEY=
